# .devcontainer/excluded-files
#
# List files that should be masked inside the container (one path per line).
# Paths are relative to the workspace root (/workspace).
# Lines starting with # are ignored.
#
# For each listed file, add a corresponding volume entry in docker-compose.yml
# (services.devcontainer.volumes):
#
#   /dev/null overlay (blanks the file):
#     - /dev/null:/workspace/<path>:ro
#
#   Dummy template (replaces with safe placeholder):
#     - ./dummy-<top-dir>/dummy.<basename>:/workspace/<path>:ro
#     → create .devcontainer/dummy-<top-dir>/dummy.<basename> (or .devcontainer/dummy.<basename>)
#       with placeholder values only
#
# Examples:
# .env
# config/secrets.yml
# src/credentials.json
