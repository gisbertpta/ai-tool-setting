readiness_checks:
  enabled: true
  postgres:
    enabled: true
    check_interval_minutes: 5
  s3:
    enabled: true
    check_interval_minutes: 5
  llm:
    enabled: true
    check_interval_minutes: 5
  azure_di:
    enabled: true
    check_interval_minutes: 5
  doc_deliver:
    enabled: true
    check_interval_minutes: 5
  netezza_dwh:
    enabled: false
    check_interval_minutes: 5
  kafka:
    enabled: true
    check_interval_minutes: 5
  fallakteneingang_ws:
    # check_fed pings the endpoint with an empty-body SOAP envelope and
    # interprets the answering fault pair (verified on the ABU stage):
    # Receiver fault = ready, Sender/SecurityError fault = credentials
    # rejected (logged as FED_CREDENTIALS_REJECTED), network error = down.
    enabled: true
    check_interval_minutes: 5

timer_jobs:
  - cron: "*/1 * * * *"
    class: backend.src.jobs.trivial_logging_job.TrivialLoggingJob
    config: {}
    job_group: application
  - cron: '* * * * *'
    class: backend.src.jobs.pipeline_processing_job.PipelineProcessingJob
    config:
      system_prefix: 'internal/fallakten/'
      summaries_internal_prefix: 'internal/summaries/'
      summaries_output_prefix: 'output/'
      stale_timeout_minutes: 60
      delay_between_jobs_seconds: 5
      max_number_of_retries: 3
    job_group: pipeline_processing
  - cron: '* * * * *'
    class: backend.src.jobs.fed_delivery_dispatcher_job.FedDeliveryDispatcherJob
    config:
      stale_timeout_minutes: 60
      max_number_of_retries: 3
    job_group: fed_delivery
  - cron: "0 0 * * *"
    class: backend.src.jobs.artifact_retention_job.ArtifactRetentionJob
    # The 21c case folder sweep reads its values (prefix, retention_days) from the
    # top-level kafka_cases block - single source, not duplicated here.
    config:
      retention_days: 60
      system_prefix: 'internal/fallakten/'
      summaries_internal_prefix: 'internal/summaries/'
    job_group: artifact_retention
  - cron: "*/5 * * * *"
    class: backend.src.jobs.classification_excel_generation_job.ClassificationEvaluationJob
    config:
      delay_between_jobs_seconds: 5
    job_group: classification_evaluation
  - cron: "*/10 * * * *"
    class: backend.src.jobs.classification_feedback_ingest_job.ClassificationFeedbackIngestJob
    config: {}
    job_group: classification_feedback_ingest
  - cron: "*/5 * * * *"
    class: backend.src.jobs.readiness_check_job.ReadinessCheckJob
    config: {}
    job_group: readiness
  - cron: "*/5 * * * *"
    class: backend.src.jobs.failed_jobs_retry_job.FailedJobsRetryJob
    config:
      max_number_of_retries: 3
    job_group: failed_jobs_retry
  - cron: "* * * * *"
    class: backend.src.jobs.retrieve_classification_fallakten_job.RetrieveClassificationFallaktenJob
    config:
        number_of_fallakten: 1
        date_from: 2025-04-01
        date_to: 2023-04-01
        store_prefix: "Evaluation_Klassifizierung/fallakten_retrieved_from_dms"
    job_group: retrieve_classification_fallakten

thread_manager:
  # Interval (in seconds) for thread health checks. Increase for less frequent checks, decrease for faster detection of thread issues.
  health_check_interval_seconds: 30
  pools:
    # Configure worker pools for different job types. Each pool can have its own max_workers.
    scheduler:
      max_workers: 1
    pipeline_processing:
      # Parallel workers for the job queue (design: 1 replica x n workers; raise deliberately).
      max_workers: 2
    fed_delivery:
      # SOAP send is cheap; one worker keeps ordering simple.
      max_workers: 1
    classification_evaluation:
      max_workers: 1

pipeline_processing:
  # Flag for toggling createn of html artifacts of summaries. Only affecting manual ('initiator'-based processing)
  create_html_artifact: true

# Deduplication cascade (document-level dedup within a case file; conservative defaults)
deduplication:
  similarity_duplicate: 0.97    # at/above this similarity + no handwriting difference -> duplicate
  similarity_candidate: 0.80    # below this similarity -> unrelated
  handwriting_delta_min: 1      # handwriting-page difference that flags an annotated (contests) pair
  page_count_tolerance: 1       # allowed page-count difference for a candidate pair
  ngram_n: 3                    # character n-gram length for fuzzy similarity




#
#  Configuration for Integration into Aktionssteuerung 21c
#

# Inbound leg (21c -> KI): Kafka Fallakte consumer on/off.
# log_message_body dumps raw payloads (Sozialdaten!) - opt-in on dev/test with
# synthetic data ONLY. MUST be false in production; treat any prod log containing
# payloads as an incident. Template default is false so prod configs derived from
# this file are safe by default.
kafka_consumer:
  enabled: true
  log_message_body: false

# Outbound leg (KI -> 21c): SOAP delivery via the FED endpoint.
# false = consume and process without calling 21c (dev/test dry-run, prod kill switch).
fed_delivery:
  enabled: true

# Development trigger endpoint (POST /dev/kafka-intake). Runs the identical intake
# path as a broker message. dev/test only - MUST stay false in production.
dev_trigger:
  enabled: false

# 21c case folders in S3: raw message, retrieved documents, raw Azure DI results.
# retention_days: sweep deletes folders whose newest object is older than this.
# Retry budgets live in the dispatcher job configs (max_number_of_retries), not here.
kafka_cases:
  prefix: internal/21c_cases/
  retention_days: 90

# Configuration for Requests to the 21c Kafka Message broker endpoint
kafka_config:
  bootstrap_servers: dak-extern-kafka-auth-bootstrap-edi-kafka-01554-extern-test.apps.ham-test01.mauintra.de:443 # Comma-separated list of Kafka servers
  topic: robotics-01554-as-information-a01001 # The topic to listen for doc_ids
  group_id: robotics-01554
  auto_offset_reset: latest # test: skip stale messages when no committed offset exists; prod: earliest
  s_ssl_keystore_base64: SSL_KEYSTORE_BASE64
  s_ssl_truststore_base64: SSL_TRUSTSTORE_BASE64
  s_ssl_keystore_password: SSL_KEYSTORE_PASSWORD
  s_ssl_truststore_password: SSL_TRUSTSTORE_PASSWORD

# Configuration for SOAP Requests to the 21c FED Endpoint
fallakteneingang_ws:
  url: https://vip-abu-21c-dialogweb.prod7330.dakitest.de:9000/partner_webservices/FallakteneingangsdatenWS #itestf
  s_username: FALLAKTENEINGANG_USERNAME # wird zu username@01554-robotics
  s_password: FALLAKTENEINGANG_PASSWORT
  username_suffix: '01554' # 01554-robotics is NO valid username_suffix
  verify_tls: true
  request_timeout: 60

doc_deliver:
  url: DOC_DELIVER_URL
  s_user: DOC_DELIVER_USER
  s_pwd: DOC_DELIVER_PASSWORD
  test_doc_id: 3954420
  client_id: xxx
  tls_verification: true