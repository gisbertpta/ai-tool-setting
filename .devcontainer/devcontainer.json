{
  "name": "Claude Code Sandbox",
  // Host-side: checks the project layer + prerequisites, builds the base image
  "initializeCommand": "bash \"${localWorkspaceFolder}/.devcontainer/initialize.sh\"",
  // Generic part + project layer (the slot .devcontainer/project/ is not tracked in this repo).
  // Build, mounts, capabilities and network isolation live in these compose files.
  "dockerComposeFile": ["docker-compose.yml", "project/compose.yml"],
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "postStartCommand": "check-exclusions",
  "remoteUser": "claude",
  "customizations": {
    "vscode": {
      "extensions": ["eamodio.gitlens"],
      "settings": { "terminal.integrated.defaultProfile.linux": "zsh" }
    }
  }
}
